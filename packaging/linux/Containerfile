# Linux release build environment for RawTap.
#
# Release binaries link against the glibc of the machine that builds them.
# Building on the oldest supported base (Ubuntu 22.04, glibc 2.35) keeps every
# Linux artifact runnable on Ubuntu 22.04+, Linux Mint 21+, Debian 12+ and
# current Fedora. Driven by scripts/build-linux-release.mjs; see
# docs/RELEASE.md.
FROM docker.io/library/ubuntu:22.04

# Set by scripts/build-linux-release.mjs from rust-toolchain.toml.
ARG RUST_VERSION
# The AppImage packer, pinned.
ARG APPIMAGETOOL_VERSION=1.9.1

ENV DEBIAN_FRONTEND=noninteractive

RUN test -n "${RUST_VERSION}" \
    || { echo "Build this image with scripts/build-linux-release.mjs, which passes the pinned Rust version." >&2; exit 1; }

# libudev-dev: serialport lists USB serial ports through libudev.
# rpm: rpmbuild, for the .rpm. desktop-file-utils: validates the launcher.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        desktop-file-utils \
        file \
        git \
        libudev-dev \
        pkg-config \
        rpm \
        rsync \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain "${RUST_VERSION}"

# appimagetool is itself an AppImage; containers have no FUSE, so let it
# extract itself instead of mounting.
ENV APPIMAGE_EXTRACT_AND_RUN=1
RUN curl -fsSL -o /usr/local/bin/appimagetool \
        "https://github.com/AppImage/appimagetool/releases/download/${APPIMAGETOOL_VERSION}/appimagetool-x86_64.AppImage" \
    && chmod 0755 /usr/local/bin/appimagetool

COPY build-in-container.sh /usr/local/bin/build-in-container.sh
ENTRYPOINT ["/usr/local/bin/build-in-container.sh"]
